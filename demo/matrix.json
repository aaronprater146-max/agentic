	"defaults": {
		"platforms": ["Win64", "Linux"],
		"outputRoot": "dist",
		"rocket": true,
		"noDebugInfo": true
	},
	"jobs": [
		{
			"plugin": "../examples/plugins/DummyPlugin/DummyPlugin.uplugin",
			"engines": ["4.27", "5.3"]
		}
	]
}
