; Engine configuration file.
; Edit with a Godot 4.7-compatible editor or as plain text.
config_version=5

[application]

config/name="Arena Pong"
config/description="A headless-verified Pong proof project generated by the Arena toolbox."
run/main_scene="res://scripts/main.gd"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]
size/viewport_width=960
size/viewport_height=540
size/window_width_override=960
size/window_height_override=540
stretch/mode="canvas_items"
handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
