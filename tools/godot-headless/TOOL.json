{
  "id": "godot-headless",
  "version": "0.1.2",
  "title": "Headless Godot 4.7 workflow",
  "entry_point": "bin/godot_headless.py",
  "runtime": {
    "python": ">=3.11",
    "third_party_python_dependencies": []
  },
  "ephemeral": true,
  "capabilities": [
    "scaffold a self-contained Pong proof project",
    "validate Android 9+ and Windows 10/11 export configuration",
    "source-build a temporary Linux x86_64 2D headless confirmation runtime",
    "run in-engine headless confirmation",
    "run configured Windows/Android exports when platform prerequisites are present",
    "bundle a verified source product",
    "mark and safely remove a disposable Arena workspace"
  ],
  "targets": {
    "android": {
      "minimum_api": 28,
      "versions": "Android 9+",
      "abis": ["arm64-v8a", "armeabi-v7a"]
    },
    "windows": {
      "versions": ["10", "11"],
      "architecture": "x86_64"
    }
  },
  "source_bootstrap": {
    "godot_tag": "4.7.2-stable",
    "source_url": "https://codeload.github.com/godotengine/godot/tar.gz/refs/tags/4.7.2-stable",
    "scons": "4.10.1",
    "supported_host": "Linux x86_64"
  },
  "confirmation_marker": "PONG_CONFIRMATION_PASS"
}
